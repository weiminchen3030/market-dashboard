# ─────────────────────────────────────────────────────────────────
# .env — Market Screener Daily Report Configuration
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and never committed.
#
# How to get a free Resend API key:
#   1. Go to https://resend.com and sign up (free, 100 emails/day)
#   2. Create an API key from the dashboard
#   3. Paste it below
#
# IMPORTANT: If you want to send FROM a custom domain (not onboarding@resend.dev),
#   verify your domain in Resend first, then set FROM_EMAIL accordingly.
# ─────────────────────────────────────────────────────────────────

# Your Resend API key (required)
RESEND_API_KEY=re_YOUR_API_KEY_HERE

# The email address to SEND the report TO (required)
TO_EMAIL=your@email.com

# The email address to SEND FROM (optional — defaults to Resend's test sender)
# For a custom domain: Market Bot <alerts@yourdomain.com>
FROM_EMAIL=Market Bot <onboarding@resend.dev>
